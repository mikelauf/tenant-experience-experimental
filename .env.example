# Copy to .env.local for local work. Never commit real keys.

# --- Site mode (build time) ---
# Unset (default): the demo. Demo dock, member app, both buildings, V2 sections labeled "in progress".
# "production": the public venue site only. A production build carries one building (the Pyramid), so every
# venue page prerenders. At start-up it logs anything still missing for real inquiries.
NEXT_PUBLIC_SITE_MODE=

# The site's public address, for absolute links (sitemap, link previews). Defaults to the Vercel production domain.
NEXT_PUBLIC_SITE_URL=

# Show the V2 sections (the facilities list) in production. Off at launch.
NEXT_PUBLIC_V2_SECTIONS=

# Building served on hosts not listed in HOSTS (Vercel previews, staging aliases). Defaults to pyramid.
PRODUCTION_TENANT=

# Opt in to search indexing once the site has launched. Everything is noindex otherwise.
SITE_INDEXABLE=

# --- Inquiries (server only) ---
# "live" sends inquiries to Core. Anything else validates them and answers with a PREVIEW reference.
PUBLIC_INQUIRY_MODE=
# Core's public gateway, e.g. https://core-staging.playbookexp.com. Staging first; production only after the staging proof.
CORE_HOST=
# Server-side public API key scoped to CORE_HOST. Ask Matt; never expose it to the browser.
CORE_PUBLIC_API_KEY=
